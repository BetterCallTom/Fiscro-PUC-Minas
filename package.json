{
  "name": "fiscro",
  "version": "0.1.0",
  "description": "FISCRO — Gerenciador de Tarefas (PUC Minas, Projeto: Aplicações Web)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "python3 -m http.server 8123 --directory src",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{js,css,html}\"",
    "format:check": "prettier --check \"src/**/*.{js,css,html}\"",
    "arch:check": "bash scripts/arch-check.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.0.0",
    "jsdom": "^24.0.0",
    "prettier": "^3.2.0",
    "vitest": "^1.6.0"
  }
}
